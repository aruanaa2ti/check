<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="Linphone" value="https://gitlab.linphone.org/api/v4/projects/411/packages/nuget/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.*" />
      <package pattern="System.*" />
    </packageSource>
    <packageSource key="Linphone">
      <package pattern="LinphoneSDK.Windows" />
    </packageSource>
  </packageSourceMapping>
</configuration>
