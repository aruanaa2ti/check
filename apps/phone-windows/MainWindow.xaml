<Window
    x:Class="PhoneWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Phone">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Padding="12,10,12,12" KeyDown="Root_KeyDown" IsTabStop="True"
          RequestedTheme="Light" Background="#FAFAFA">
        <Grid.Resources>
            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
            <RowDefinition Height="264"/>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="38"/>
                <ColumnDefinition Width="38"/>
                <ColumnDefinition Width="38"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="9">
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#999999"/>
                <StackPanel Spacing="0">
                    <TextBlock x:Name="StatusText" Text="Configure seu ramal" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ExtensionText" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Click="Contacts_Click" ToolTipService.ToolTip="Contatos" Style="{StaticResource ToolbarButtonStyle}">
                <FontIcon Glyph="&#xE77B;" FontSize="17"/>
            </Button>
            <Button Grid.Column="2" Click="History_Click" ToolTipService.ToolTip="Histórico" Style="{StaticResource ToolbarButtonStyle}">
                <FontIcon Glyph="&#xE81C;" FontSize="17"/>
            </Button>
            <Button Grid.Column="3" Click="Settings_Click" ToolTipService.ToolTip="Configurações" Style="{StaticResource ToolbarButtonStyle}">
                <FontIcon Glyph="&#xE713;" FontSize="17"/>
            </Button>
        </Grid>

        <TextBlock x:Name="NumberText" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable Display" FontSize="29" TextTrimming="CharacterEllipsis"/>

        <Grid Grid.Row="3" Width="196" Height="264">
            <Grid.Resources>
                <Style x:Key="DialButtonStyle" TargetType="Button">
                    <Setter Property="Width" Value="60"/>
                    <Setter Property="Height" Value="60"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="CornerRadius" Value="30"/>
                    <Setter Property="Background" Value="{StaticResource KeyBrush}"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/><ColumnDefinition Width="8"/><ColumnDefinition Width="60"/><ColumnDefinition Width="8"/><ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/><RowDefinition Height="8"/><RowDefinition Height="60"/><RowDefinition Height="8"/>
                <RowDefinition Height="60"/><RowDefinition Height="8"/><RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Tag="1" Click="Dial_Click" Style="{StaticResource DialButtonStyle}"><TextBlock Text="1" FontSize="29"/></Button>
            <Button Grid.Row="0" Grid.Column="2" Tag="2" Click="Dial_Click" Style="{StaticResource DialButtonStyle}"><StackPanel Spacing="-3"><TextBlock Text="2" FontSize="29" HorizontalAlignment="Center"/><TextBlock Text="A B C" FontSize="8" FontWeight="SemiBold"/></StackPanel></Button>
            <Button Grid.Row="0" Grid.Column="4" Tag="3" Click="Dial_Click" Style="{StaticResource DialButtonStyle}"><StackPanel Spacing="-3"><TextBlock Text="3" FontSize="29" HorizontalAlignment="Center"/><TextBlock Text="D E F" FontSize="8" FontWeight="SemiBold"/></StackPanel></Button>
            <Button Grid.Row="2" Grid.Column="0" Tag="4" Click="Dial_Click" Style="{StaticResource DialButtonStyle}"><StackPanel Spacing="-3"><TextBlock Text="4" FontSize="29" HorizontalAlignment="Center"/><TextBlock Text="G H I" FontSize="8" FontWeight="SemiBold"/></StackPanel></Button>
            <Button Grid.Row="2" Grid.Column="2" Tag="5" Click="Dial_Click" Style="{StaticResource DialButtonStyle}"><StackPanel Spacing="-3"><TextBlock Text="5" FontSize="29" HorizontalAlignment="Center"/><TextBlock Text="J K L" FontSize="8" FontWeight="SemiBold"/></StackPanel></Button>
            <Button Grid.Row="2" Grid.Column="4" Tag="6" Click="Dial_Click" Style="{StaticResource DialButtonStyle}"><StackPanel Spacing="-3"><TextBlock Text="6" FontSize="29" HorizontalAlignment="Center"/><TextBlock Text="M N O" FontSize="8" FontWeight="SemiBold"/></StackPanel></Button>
            <Button Grid.Row="4" Grid.Column="0" Tag="7" Click="Dial_Click" Style="{StaticResource DialButtonStyle}"><StackPanel Spacing="-3"><TextBlock Text="7" FontSize="29" HorizontalAlignment="Center"/><TextBlock Text="P Q R S" FontSize="8" FontWeight="SemiBold"/></StackPanel></Button>
            <Button Grid.Row="4" Grid.Column="2" Tag="8" Click="Dial_Click" Style="{StaticResource DialButtonStyle}"><StackPanel Spacing="-3"><TextBlock Text="8" FontSize="29" HorizontalAlignment="Center"/><TextBlock Text="T U V" FontSize="8" FontWeight="SemiBold"/></StackPanel></Button>
            <Button Grid.Row="4" Grid.Column="4" Tag="9" Click="Dial_Click" Style="{StaticResource DialButtonStyle}"><StackPanel Spacing="-3"><TextBlock Text="9" FontSize="29" HorizontalAlignment="Center"/><TextBlock Text="W X Y Z" FontSize="8" FontWeight="SemiBold"/></StackPanel></Button>
            <Button Grid.Row="6" Grid.Column="0" Tag="*" Click="Dial_Click" Style="{StaticResource DialButtonStyle}"><TextBlock Text="*" FontSize="29"/></Button>
            <Button Grid.Row="6" Grid.Column="2" Tag="0" Click="Dial_Click" Style="{StaticResource DialButtonStyle}"><StackPanel Spacing="-3"><TextBlock Text="0" FontSize="29" HorizontalAlignment="Center"/><TextBlock Text="+" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></Button>
            <Button Grid.Row="6" Grid.Column="4" Tag="#" Click="Dial_Click" Style="{StaticResource DialButtonStyle}"><TextBlock Text="#" FontSize="29"/></Button>
        </Grid>

        <Grid Grid.Row="4" Width="196">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="CallButton" Grid.Column="1" Width="54" Height="54" Padding="0" CornerRadius="27"
                    Background="{StaticResource PhoneGreenBrush}" Foreground="White" Click="Call_Click">
                <FontIcon x:Name="CallIcon" Glyph="&#xE717;" FontSize="22"/>
            </Button>
            <Button x:Name="DeleteButton" Grid.Column="2" Width="42" Height="42" Padding="0" Background="Transparent"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Click="Delete_Click">
                <FontIcon Glyph="&#xE750;" FontSize="19"/>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Back" Invoked="Backspace_Invoked"/>
                    <KeyboardAccelerator Key="Delete" Invoked="Backspace_Invoked"/>
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
            <Button x:Name="SpeakerButton" Visibility="Collapsed" Click="Speaker_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="SpeakerIcon" Glyph="&#xE767;" FontSize="14"/>
                    <TextBlock x:Name="SpeakerText" Text="Viva-voz"/>
                </StackPanel>
            </Button>
            <Button x:Name="TransferButton" Visibility="Collapsed" Click="Transfer_Click" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE8AB;" FontSize="13"/>
                    <TextBlock Text="Transferir"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock Grid.Row="6" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,2" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}">
            <Run Text="Desenvolvido por "/>
            <Hyperlink NavigateUri="https://a2ti.com.br/">
                <Run Text="a2" FontWeight="SemiBold"/>
            </Hyperlink>
        </TextBlock>

    </Grid>
</Window>
