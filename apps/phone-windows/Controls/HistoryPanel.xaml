<UserControl
    x:Class="PhoneWindows.Controls.HistoryPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PhoneWindows.Models">
    <Grid Width="430" Height="460" RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ListView x:Name="HistoryList" IsItemClickEnabled="True" ItemClick="HistoryList_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:CallHistoryItem">
                    <Grid Padding="5" ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind DirectionGlyph}" FontSize="17" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Number}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind DateLabel}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Tag="{x:Bind Id}" Click="Delete_Click" Background="Transparent" ToolTipService.ToolTip="Excluir">
                            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="EmptyText" Text="Nenhuma ligação" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Button Grid.Row="1" HorizontalAlignment="Right" Click="Clear_Click" Foreground="#CC2222" Background="Transparent">
            Limpar histórico
        </Button>
    </Grid>
</UserControl>
