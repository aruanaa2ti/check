<UserControl
    x:Class="PhoneWindows.Controls.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Width="470" Height="520" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Padding="2,4,10,8">
            <StackPanel Spacing="3">
                <TextBlock Text="Ramal" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="CurrentStateText" Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>

            <ToggleSwitch x:Name="RegistrationToggle" Header="Ativar registro SIP" Toggled="RegistrationToggle_Toggled"/>

            <Border Background="#08000000" CornerRadius="10" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Configurar pelo link" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="Cole o link copiado no PABX para preencher o ramal automaticamente."
                               FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBox x:Name="QrValueBox" PlaceholderText="Cole aqui o endereço do QR Code" TextWrapping="Wrap"/>
                    <Button Content="Configurar ramal" HorizontalAlignment="Left" Click="Provision_Click"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Configuração manual" FontSize="16" FontWeight="SemiBold"/>
            <Grid ColumnSpacing="10" RowSpacing="9">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="ExtensionBox" Header="Ramal" PlaceholderText="299"/>
                <TextBox x:Name="UserBox" Grid.Column="1" Header="Usuário de autenticação"/>
                <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.ColumnSpan="2" Header="Senha SIP"/>
                <TextBox x:Name="HostBox" Grid.Row="2" Grid.ColumnSpan="2" Header="Servidor SIP" PlaceholderText="pabx.exemplo.com.br"/>
                <NumberBox x:Name="PortBox" Grid.Row="3" Header="Porta" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Hidden"/>
                <ComboBox x:Name="TransportBox" Grid.Row="3" Grid.Column="1" Header="Transporte" SelectedIndex="0">
                    <ComboBoxItem Content="UDP" Tag="udp"/><ComboBoxItem Content="TCP" Tag="tcp"/><ComboBoxItem Content="TLS" Tag="tls"/>
                </ComboBox>
                <Button Grid.Row="4" Grid.ColumnSpan="2" Content="Salvar e reconectar" Click="Save_Click"
                        HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"/>
            </Grid>

            <TextBlock Text="Áudio" FontSize="16" FontWeight="SemiBold"/>
            <ComboBox x:Name="MicrophoneBox" Header="Microfone" HorizontalAlignment="Stretch"
                      SelectionChanged="MicrophoneBox_SelectionChanged"/>
            <ComboBox x:Name="OutputBox" Header="Áudio da ligação" HorizontalAlignment="Stretch"
                      SelectionChanged="OutputBox_SelectionChanged"/>
            <ComboBox x:Name="RingerBox" Header="Campainha" HorizontalAlignment="Stretch"
                      SelectionChanged="RingerBox_SelectionChanged"/>
            <TextBlock Text="Você pode tocar nos alto-falantes do PC e conversar pelo Phone USB."
                       FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"/>

            <ToggleSwitch x:Name="StartupToggle" Header="Abrir Phone ao iniciar o Windows" Toggled="StartupToggle_Toggled"/>
            <TextBlock Text="Com o Phone aberto ou minimizado, chamadas continuam tocando com a tela bloqueada. O PC precisa estar acordado."
                       FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"/>

            <Button x:Name="RemoveButton" Content="Remover configuração" Foreground="#CC2222" Background="Transparent"
                    HorizontalAlignment="Left" Click="Remove_Click"/>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="12"/>
            <TextBlock Text="Phone para Windows · 0.1.7" FontSize="11" HorizontalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
